spring:
  application:
    name: mediscan-ai

  datasource:
    url: jdbc:mysql://localhost:3307/mediscan_db
    username: your_mysql_user
    password: your_mysql_password
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    open-in-view: false
    properties:
      hibernate:
        # MySQL8Dialect was removed in Hibernate 6 — use MySQLDialect instead
        dialect: org.hibernate.dialect.MySQLDialect
        format_sql: true

  data:
    mongodb:
      uri: mongodb://your_mongo_user:your_mongo_password@localhost:27017/mediscan_docs?authSource=admin
      database: mediscan_docs
      auto-index-creation: false
    redis:
      host: localhost
      port: 6379
      password: your_redis_password

  servlet:
    multipart:
      enabled: true
      max-file-size: 10MB
      max-request-size: 15MB

server:
  port: 8080

app:
  jwt:
    secret: your-jwt-secret-key-min-32-characters-long
    expiration-ms: 3600000
  minio:
    endpoint: http://localhost:9000
    access-key: your_minio_access_key
    secret-key: your_minio_secret_key
    bucket-reports: mediscan-reports

logging:
  level:
    com.mediscan: DEBUG
    org.springframework.security: INFO
    org.springframework.data.mongodb: WARN
